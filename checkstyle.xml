<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Spotless handles layout. These rules catch things a formatter cannot: likely bugs, debug output and
  naming. Run with ./mvnw checkstyle:check (also part of ./mvnw verify).
-->
<module name="Checker">
    <property name="severity" value="warning"/>

    <module name="TreeWalker">
        <!-- Likely bugs -->
        <module name="EqualsHashCode"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="StringLiteralEquality"/>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>
        <module name="SimplifyBooleanExpression"/>
        <module name="OneStatementPerLine"/>
        <module name="ModifiedControlVariable"/>

        <!-- Clean code -->
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <module name="FinalClass"/>
        <module name="MutableException"/>
        <module name="NeedBraces"/>

        <!-- Logging instead of printing -->
        <module name="Regexp">
            <property name="format" value="System\.(out|err)\.print|printStackTrace\(\)"/>
            <property name="illegalPattern" value="true"/>
            <property name="message" value="Use a logger instead"/>
        </module>

        <!-- Naming -->
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <!-- The usual logger name "log" is allowed -->
        <module name="ConstantName">
            <property name="format" value="^log$|^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>
        <module name="PackageName">
            <property name="format" value="^com\.kalalev\.booking(\.[a-z]+)*$"/>
        </module>
    </module>
</module>
