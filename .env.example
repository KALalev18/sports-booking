# Only needed when you run the app against your own PostgreSQL.
# Locally, ./mvnw spring-boot:run starts PostgreSQL and Mailpit from compose.yaml and uses the defaults.
DB_URL=jdbc:postgresql://localhost:5432/booking
DB_USERNAME=booking
DB_PASSWORD=booking

# Signs API tokens (HS256), at least 32 characters. If unset, a random key is made at each start.
BOOKING_JWT_SECRET=

# Activates demo data (facilities, courts, bookings, demo accounts) on an empty database.
SPRING_PROFILES_ACTIVE=demo
DEMO_PASSWORD=demo1234

# Outgoing email. If unset, emails are written to the log instead.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=1025
